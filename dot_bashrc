#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '

eval "$(fzf --bash)"
eval -- "$(/usr/bin/starship init bash --print-full-init)"

export EDITOR=nvim

alias k=kubectl
alias vim=nvim
alias vi=nvim
. "$HOME/.cargo/env"
